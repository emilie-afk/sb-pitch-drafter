# Placeholders only. Set real values in Netlify (scope: Functions, secret).
APP_PASSWORD=<shared team password>
SESSION_SECRET=<random string, at least 32 characters, different from APP_PASSWORD>
ANTHROPIC_API_KEY=<anthropic api key>
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<GID>
PACKAGE_TRACKER_URL=https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit#gid=<GID>
ASSESSMENT_SECRET=<machine secret shared with the Apps Script, at least 16 characters>
# ASSESSMENT_SECRET_NEXT=<only while rotating the machine secret>
